{{- /* Web app manifest for this edition, for "Install app" on Android.
       Each edition has its own id and start_url, so a reader installs the
       edition they are reading; scope is the whole site, so links to other
       editions stay inside the app. Shortcuts (long-press the app icon)
       are the first three menu items: Archive, Topics, Search. The manifest
       names itself under related_applications so the install page can ask
       Chrome whether this edition is already installed. */ -}}
{{- $home := site.Home.RelPermalink -}}
{{- $icons := slice
      (dict "src" ("icons/icon-192.png" | relURL) "sizes" "192x192" "type" "image/png" "purpose" "any")
      (dict "src" ("logo-512.png" | relURL) "sizes" "512x512" "type" "image/png" "purpose" "any")
      (dict "src" ("icons/maskable-512.png" | relURL) "sizes" "512x512" "type" "image/png" "purpose" "maskable") -}}
{{- $shortcuts := slice -}}
{{- range first 3 site.Menus.main -}}
{{- $shortcuts = $shortcuts | append (dict
      "name" .Name
      "url" (.URL | relLangURL)
      "icons" (slice (dict "src" ("icons/icon-192.png" | relURL) "sizes" "192x192" "type" "image/png"))) -}}
{{- end -}}
{{- dict
      "id" $home
      "name" site.Title
      "short_name" "AI News"
      "description" site.Params.description
      "lang" site.Language.LanguageCode
      "dir" "ltr"
      "start_url" $home
      "scope" ("/" | relURL)
      "display" "standalone"
      "background_color" site.Params.assets.theme_color
      "theme_color" site.Params.assets.theme_color
      "categories" (slice "news")
      "icons" $icons
      "shortcuts" $shortcuts
      "related_applications" (slice (dict "platform" "webapp" "url" (site.Home.OutputFormats.Get "manifest").Permalink))
    | jsonify (dict "indent" "  ") -}}
