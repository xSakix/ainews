# Response headers for Cloudflare static assets (Workers and Pages).
# https://developers.cloudflare.com/workers/static-assets/headers/

# Fingerprinted CSS and JS: the file name changes whenever the content does.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=604800

# Machine-readable copies for AI tools: crawlable, but kept out of search
# results so they do not compete with the HTML pages.
/posts/:slug/index.md
  X-Robots-Tag: noindex
/about/index.md
  X-Robots-Tag: noindex
/llms.txt
  X-Robots-Tag: noindex
/llms-full.txt
  X-Robots-Tag: noindex
